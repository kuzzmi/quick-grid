{
  "manifest_version": 3,
  "name": "QuickGrid",
  "version": "1.0",
  "description": "A customizable grid of quick links for your new tab page",
  "permissions": ["storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}